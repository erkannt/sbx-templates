FROM docker/sandbox-templates:shell-docker

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
  curl \
  git \
  build-essential \
  ca-certificates \
  fonts-liberation \
  libatk-bridge2.0-0 \
  libatk1.0-0 \
  libcairo2 \
  libcups2 \
  libdbus-1-3 \
  libexpat1 \
  libfontconfig1 \
  libgbm1 \
  libglib2.0-0 \
  libgtk-3-0 \
  libnspr4 \
  libnss3 \
  libpango-1.0-0 \
  libpangocairo-1.0-0 \
  libx11-6 \
  libx11-xcb1 \
  libxcb1 \
  libxcomposite1 \
  libxcursor1 \
  libxdamage1 \
  libxext6 \
  libxfixes3 \
  libxi6 \
  libxrandr2 \
  libxrender1 \
  libxss1 \
  libxtst6 \
  wget \
  xdg-utils \
  && (apt-get install -y libasound2 2>/dev/null || apt-get install -y libasound2t64) \
  && rm -rf /var/lib/apt/lists/*

USER agent

# Ensure mise shims and bin are on PATH for subsequent RUN steps
ENV PATH="/home/agent/.local/share/mise/shims:/home/agent/.local/bin:${PATH}"

RUN curl https://mise.run | sh

RUN echo 'eval "$(~/.local/bin/mise activate bash)"' >> ~/.bashrc

# Install runtimes + pnpm
RUN mise use --global node@lts go@latest uv@latest

RUN npm install -g pnpm

# Install agents
RUN npm install -g \
  @earendil-works/pi-coding-agent \
  opencode-ai \
  dirac-cli \
  @anthropic-ai/claude-code
